# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=timeoff-demo-app
APP_ENV=development
PORT=3000

# ── Authentication (Ory Hydra OIDC — UAB BlazerID sign-in) ────────────────
# Locally, .env.local already has real, working values — nothing to fill in
# here for local development. If this app is later deployed somewhere
# permanent, whoever deploys it needs to register a client with UAB's Ory
# Hydra server for that deployment's URL and set these three there.
#   NEXT_PUBLIC_AUTH_URL  — UAB's identity server (Ory Hydra) URL
#   NEXT_PUBLIC_CLIENT_ID — the Hydra client ID registered for this app
#                           ("timeoff-demo-app" is the ID to register)
#   NEXT_PUBLIC_REDIRECT_URL — that deployment's app URL
NEXT_PUBLIC_AUTH_URL=YOUR_HYDRA_AUTHORITY_URL
NEXT_PUBLIC_CLIENT_ID=YOUR_HYDRA_CLIENT_ID
NEXT_PUBLIC_REDIRECT_URL=YOUR_APP_URL

# ── Data storage (works automatically — nothing to fill in) ───────────────
# This app saves data to a local file (see README.md) — no configuration
# needed, locally or wherever it's later deployed.
